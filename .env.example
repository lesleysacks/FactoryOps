# FactoryOps — Environment Variable Template
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# REQUIRED: Generate a strong random key (do not use this placeholder in real use):
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-this-to-a-long-random-secret-string

# Set to False on any network-exposed or production host
DEBUG=True

# Comma-separated list of allowed hostnames (no spaces required; whitespace is trimmed).
# Default local access:
ALLOWED_HOSTS=localhost,127.0.0.1
#
# For LAN / factory-PC testing, append your machine's IPv4 address (no brackets, no quotes):
#   Windows:  ipconfig
#   Linux:    ip addr
#   macOS:    ifconfig
# Example:
#   ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.105
#
# Do NOT use a wildcard host list.
#
# Production on a Windows factory PC uses config/settings/production.py.
# The installer writes C:\FactoryOps\config\factoryops.env and generates SECRET_KEY once.
# It does not rotate that key on later starts. See the factory deployment guide in README.md.
# FACTORYOPS_BIND=0.0.0.0
# FACTORYOPS_PORT=8000
# FACTORYOPS_HTTPS=False
# FACTORYOPS_SQLITE_PATH=C:\FactoryOps\data\db.sqlite3
# FACTORYOPS_MEDIA_ROOT=C:\FactoryOps\data\media
# FACTORYOPS_STATIC_ROOT=C:\FactoryOps\staticfiles
# FACTORYOPS_LOG_DIR=C:\FactoryOps\logs
# FACTORYOPS_BACKUP_DIR=C:\FactoryOps\backups
# FACTORYOPS_BACKUP_RETENTION=14
# FACTORYOPS_ENV_FILE=C:\FactoryOps\config\factoryops.env
# CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
