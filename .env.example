# FactoryOps — Environment Variable Template
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# REQUIRED: Generate a strong random key (do not use this placeholder in real use):
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-this-to-a-long-random-secret-string

# Set to False on any network-exposed or production host
DEBUG=True

# Comma-separated list of allowed hostnames (no spaces required; whitespace is trimmed).
# Default local access:
ALLOWED_HOSTS=localhost,127.0.0.1
#
# For LAN / factory-PC testing, append your machine's IPv4 address (no brackets, no quotes):
#   Windows:  ipconfig
#   Linux:    ip addr
#   macOS:    ifconfig
# Example:
#   ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.105
#
# Do NOT use a wildcard host list.

# Optional in development. Required when DJANGO_SETTINGS_MODULE=config.settings.production.
# Include the scheme and port for every URL operators or phones actually open.
# CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Factory PC process settings. Empty paths use the project directory.
# FACTORYOPS_BIND=0.0.0.0
# FACTORYOPS_PORT=8000
# FACTORYOPS_KIOSK_URL=http://127.0.0.1:8000/accounts/login/
# FACTORYOPS_USE_HTTPS=False
# FACTORYOPS_LOG_DIR=
# FACTORYOPS_BACKUP_DIR=
# FACTORYOPS_BACKUP_RETENTION_DAYS=14
# FACTORYOPS_DB_PATH=
# FACTORYOPS_MEDIA_ROOT=
