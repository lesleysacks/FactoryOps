# FactoryOps production environment for the Windows 11 factory PC.
# Copy to .env next to manage.py and replace the placeholder secret.
# Never commit the filled-in .env.

# Generate a real key and paste it here. The placeholder will not boot.
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-this-to-a-long-random-secret-string

# Production settings force DEBUG off even if this line is wrong.
DEBUG=False

# Hostnames and the factory PC LAN address. No wildcard. No port numbers.
ALLOWED_HOSTS=localhost,127.0.0.1

# Scheme and port for every browser URL, including phones.
# After you reserve a LAN address, add it here and in ALLOWED_HOSTS.
# Example: http://127.0.0.1:8000,http://localhost:8000,http://192.168.1.50:8000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Listen on the LAN interface. The Windows firewall rule must limit this to
# the private factory subnet. Do not publish this port on the router.
FACTORYOPS_BIND=0.0.0.0
FACTORYOPS_PORT=8000

# Full-screen display opens the login page. Do not put a password here.
FACTORYOPS_KIOSK_URL=http://127.0.0.1:8000/accounts/login/

# Leave false until TLS is actually terminating in front of FactoryOps.
FACTORYOPS_USE_HTTPS=False

# Optional absolute paths. Empty uses the defaults chosen by the install script.
FACTORYOPS_LOG_DIR=
FACTORYOPS_DB_PATH=
FACTORYOPS_MEDIA_ROOT=
FACTORYOPS_BACKUP_DIR=
FACTORYOPS_BACKUP_RETENTION_DAYS=14

# Optional Google Sheets reporting. Off until you set True AND both values below.
# Put the service-account JSON outside the checkout, for example
# C:\FactoryOps\secrets\factoryops-sheets.json
# Share the spreadsheet with the client_email inside that file. Do not commit the file.
GOOGLE_SHEETS_ENABLED=False
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CREDENTIALS_FILE=
# GOOGLE_SHEETS_DATASETS=production_output,qc_results,stock_movements
# GOOGLE_SHEETS_TIMEOUT_SECONDS=30
# GOOGLE_SHEETS_MAX_ATTEMPTS=5
# GOOGLE_SHEETS_BACKOFF_SECONDS=2
# GOOGLE_SHEETS_BATCH_SIZE=100
